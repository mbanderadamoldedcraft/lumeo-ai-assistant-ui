{% extends 'base.html.twig' %}

{% block body %}
<div class="min-h-screen flex bg-[#f8fafc] text-slate-800 antialiased selection:bg-purple-100">
    
    <!-- LEFT SIDEBAR -->
    <aside class="w-[76px] h-screen sticky top-0 bg-white border-r border-slate-200/60 flex flex-col items-center justify-between py-5 shrink-0 z-20 overflow-y-hidden">
        
        <!-- Top Logo -->
        <div class="flex flex-col items-center gap-6 w-full">
            <div class="w-10 h-10 rounded-full bg-slate-900 flex items-center justify-center text-white shadow-sm transition duration-200 cursor-pointer">
                <!-- Spoke Sunburst Logo -->
                <svg class="w-6 h-6" viewBox="0 0 100 100" fill="currentColor">
                    <circle cx="50" cy="50" r="10" />
                    <g stroke="currentColor" stroke-width="6" stroke-linecap="round">
                        <line x1="50" y1="20" x2="50" y2="8" />
                        <line x1="50" y1="80" x2="50" y2="92" />
                        <line x1="20" y1="50" x2="8" y2="50" />
                        <line x1="80" y1="50" x2="92" y2="50" />
                        <line x1="29" y1="29" x2="20" y2="20" />
                        <line x1="71" y1="71" x2="80" y2="80" />
                        <line x1="29" y1="71" x2="20" y2="80" />
                        <line x1="71" y1="29" x2="80" y2="20" />
                        <line x1="39" y1="22" x2="34" y2="10" />
                        <line x1="61" y1="78" x2="66" y2="90" />
                        <line x1="22" y1="39" x2="10" y2="34" />
                        <line x1="78" y1="61" x2="90" y2="66" />
                        <line x1="22" y1="61" x2="10" y2="66" />
                        <line x1="78" y1="39" x2="90" y2="34" />
                        <line x1="39" y1="78" x2="34" y2="90" />
                        <line x1="61" y1="22" x2="66" y2="10" />
                    </g>
                </svg>
            </div>
            
            <!-- Sidebar Navigation Icons -->
            <nav class="flex flex-col items-center gap-1 w-full" id="sidebar-nav">
                {% set current_route = app.request.attributes.get('_route') ?? '' %}
                {% set active_classes = 'bg-purple-50 text-purple-600 border border-purple-100/60' %}
                {% set inactive_classes = 'text-slate-900 hover:bg-slate-100 hover:text-purple-600' %}

                <!-- Home -->
                <a href="{{ path('app_dashboard') }}" data-tab="home" class="sidebar-tab relative w-9 h-9 flex items-center justify-center rounded-xl transition group cursor-pointer {{ current_route == 'app_dashboard' ? active_classes : inactive_classes }}" title="Home">
                    {% if current_route == 'app_dashboard' %}
                    <span class="absolute left-[-8px] w-[3px] h-5 bg-purple-600 rounded-r-full transition-transform active-indicator"></span>
                    {% endif %}
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
                        <polyline points="9 22 9 12 15 12 15 22"/>
                    </svg>
                </a>
                
                <!-- Chat -->
                <button data-tab="chat" class="sidebar-tab relative w-9 h-9 flex items-center justify-center rounded-xl transition cursor-pointer {{ inactive_classes }}" title="Chats">
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </button>
                
                <!-- History -->
                <button data-tab="history" class="sidebar-tab relative w-9 h-9 flex items-center justify-center rounded-xl transition cursor-pointer {{ inactive_classes }}" title="History">
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/>
                        <polyline points="3 3 3 8 8 8"/>
                        <line x1="12" y1="7" x2="12" y2="12"/>
                        <line x1="12" y1="12" x2="16" y2="14"/>
                    </svg>
                </button>
                
                <!-- Assistant / Bot -->
                <button data-tab="bot" class="sidebar-tab relative w-9 h-9 flex items-center justify-center rounded-xl transition cursor-pointer {{ inactive_classes }}" title="AI Assistants">
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="11" width="18" height="10" rx="2"/>
                        <circle cx="12" cy="5" r="2"/>
                        <path d="M12 7v4"/>
                        <line x1="8" y1="16" x2="8.01" y2="16"/>
                        <line x1="16" y1="16" x2="16.01" y2="16"/>
                        <path d="M2 14h1"/>
                        <path d="M21 14h1"/>
                    </svg>
                </button>
                
                <!-- Folders -->
                <button data-tab="folders" class="sidebar-tab relative w-9 h-9 flex items-center justify-center rounded-xl transition cursor-pointer {{ inactive_classes }}" title="Library">
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
                    </svg>
                </button>
                
                <!-- Share -->
                <button data-tab="share" class="sidebar-tab relative w-9 h-9 flex items-center justify-center rounded-xl transition cursor-pointer {{ inactive_classes }}" title="Sharing">
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="18" cy="5" r="3"/>
                        <circle cx="6" cy="12" r="3"/>
                        <circle cx="18" cy="19" r="3"/>
                        <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                        <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                    </svg>
                </button>
                
                <!-- Database -->
                <button data-tab="database" class="sidebar-tab relative w-9 h-9 flex items-center justify-center rounded-xl transition cursor-pointer {{ inactive_classes }}" title="Data Sources">
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <ellipse cx="12" cy="5" rx="9" ry="3"/>
                        <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>
                        <path d="M3 12c0 1.66 4 3 9 3s9-1.34 9-3"/>
                    </svg>
                </button>

                <!-- User Management -->
                <a href="{{ path('app_user_index') }}" class="sidebar-tab relative w-9 h-9 flex items-center justify-center rounded-xl transition cursor-pointer {{ current_route starts with 'app_user' ? active_classes : inactive_classes }}" title="User Management">
                    {% if current_route starts with 'app_user' %}
                    <span class="absolute left-[-8px] w-[3px] h-5 bg-purple-600 rounded-r-full transition-transform active-indicator"></span>
                    {% endif %}
                    <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                    </svg>
                </a>
            </nav>
        </div>
        
        <!-- Bottom Section -->
        <div class="flex flex-col items-center gap-1.5 w-full">
            <!-- Support / Headphones -->
            <button class="w-9 h-9 flex items-center justify-center rounded-xl text-slate-900 transition cursor-pointer hover:bg-slate-100 hover:text-purple-600" title="Help & Support">
                <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
                    <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 1 2 2h1a2 2 0 0 1 2-2v-3a2 2 0 0 1-2-2H3z"/>
                </svg>
            </button>
            
            <!-- Settings -->
            <button class="w-9 h-9 flex items-center justify-center rounded-xl text-slate-900 transition cursor-pointer hover:bg-slate-100 hover:text-purple-600" title="Settings">
                <svg class="w-[18px] h-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
            </button>
            
            <!-- User Avatar -->
            <div class="w-9 h-9 rounded-full overflow-hidden border border-slate-200 mt-2 transition cursor-pointer">
                <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=120&h=120" alt="Jason" class="w-full h-full object-cover">
            </div>
        </div>
    </aside>
    
    <!-- MAIN CONTENT CONTAINER -->
    <main class="flex-1 flex flex-col min-w-0 bg-[#fbfcfd]">
        
        <!-- TOP HEADER ROW -->
        <header class="h-[76px] px-8 flex items-center justify-between border-b border-slate-100 bg-[#fbfcfd]">
            
            <!-- Model Indicator: ChatGPT 4o -->
            <div class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/80 rounded-md text-[14px] font-semibold text-slate-700 shadow-sm select-none">
                <svg class="w-4 h-4 text-violet-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                </svg>
                <span>ChatGPT 4o</span>
                <svg class="w-3 h-3 text-slate-400 ml-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                </svg>
            </div>
            
            <!-- Right Actions Buttons -->
            <div class="flex items-center gap-3">
                <!-- Search thread -->
                <button class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/40 rounded-md text-[14px] font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition active:scale-95 cursor-pointer" id="search-btn">
                    <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="11" cy="11" r="8"/>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"/>
                    </svg>
                    Search thread
                </button>
                
                <!-- Invite -->
                <button class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/40 rounded-md text-[14px] font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition active:scale-95 cursor-pointer" id="invite-btn">
                    <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <line x1="19" y1="8" x2="19" y2="14"/>
                        <line x1="22" y1="11" x2="16" y2="11"/>
                    </svg>
                    Invite
                </button>
                
                <!-- + New Thread -->
                <button class="flex items-center gap-2 px-4 py-2 bg-slate-900 text-white rounded-md text-[14px] font-semibold shadow-sm hover:bg-slate-800 transition active:scale-95 cursor-pointer" id="new-thread-btn">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                    New Thread
                </button>

                <!-- Login -->
                <a href="{{ path('app_login') }}" class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/80 rounded-md text-[14px] font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition active:scale-95 cursor-pointer" id="login-btn">
                    <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    Login
                </a>

                <!-- Register -->
                <a href="{{ path('app_register') }}" class="flex items-center gap-2 px-4 py-2 bg-white border border-slate-200/80 rounded-md text-[14px] font-semibold text-slate-700 shadow-sm hover:bg-slate-50 transition active:scale-95 cursor-pointer" id="register-btn">
                    <svg class="w-4 h-4 text-slate-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
                        <circle cx="9" cy="7" r="4"/>
                        <line x1="19" y1="8" x2="19" y2="14"/>
                        <line x1="22" y1="11" x2="16" y2="11"/>
                    </svg>
                    Register
                </a>
            </div>
        </header>

        {% block content %}{% endblock %}

    </main>
</div>

{% block javascripts %}
{{ parent() }}
<script>
    // 8. Search Thread action
    const searchBtn = document.getElementById('search-btn');
    if (searchBtn) {
        searchBtn.addEventListener('click', () => {
            // Search functionality
        });
    }

    // 9. Invite action
    const inviteBtn = document.getElementById('invite-btn');
    if (inviteBtn) {
        inviteBtn.addEventListener('click', () => {
            // Invite functionality
        });
    }

    // Interactive Sidebar Tabs
    const sidebarTabs = document.querySelectorAll('.sidebar-tab');
    const activeClasses = ['bg-purple-50', 'text-purple-600', 'border', 'border-purple-100/60'];
    const inactiveClasses = ['text-slate-900', 'hover:bg-slate-100', 'hover:text-purple-600'];

    sidebarTabs.forEach(tab => {
        tab.addEventListener('click', function() {
            // Remove active state from all
            sidebarTabs.forEach(t => {
                t.classList.remove(...activeClasses);
                t.classList.add(...inactiveClasses);
                const indicator = t.querySelector('.active-indicator');
                if (indicator) indicator.remove();
            });

            // Add active state to clicked
            this.classList.remove(...inactiveClasses);
            this.classList.add(...activeClasses);

            const newIndicator = document.createElement('span');
            newIndicator.className = 'absolute left-[-8px] w-[3px] h-5 bg-purple-600 rounded-r-full transition-transform active-indicator';
            this.appendChild(newIndicator);
        });
    });
</script>
{% endblock %}
{% endblock %}
