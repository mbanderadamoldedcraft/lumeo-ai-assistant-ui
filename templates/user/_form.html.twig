{{ form_start(form, {'attr': {'class': 'space-y-6', 'novalidate': 'novalidate'}}) }}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="form-group flex flex-col gap-1">
            {{ form_label(form.username, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-700'}}) }}
            {{ form_widget(form.username, {'attr': {'class': 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition'}}) }}
            {{ form_errors(form.username, {'attr': {'class': 'text-red-500 text-xs'}}) }}
        </div>
        
        <div class="form-group flex flex-col gap-1">
            {{ form_label(form.password, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-700'}}) }}
            {{ form_widget(form.password, {'attr': {'class': 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition'}}) }}
            {{ form_errors(form.password, {'attr': {'class': 'text-red-500 text-xs'}}) }}
            <p class="text-xs text-slate-400">Leave empty to keep existing password when updating.</p>
        </div>

        <div class="form-group flex flex-col gap-1">
            {{ form_label(form.firstName, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-700'}}) }}
            {{ form_widget(form.firstName, {'attr': {'class': 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition'}}) }}
            {{ form_errors(form.firstName) }}
        </div>

        <div class="form-group flex flex-col gap-1">
            {{ form_label(form.lastName, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-700'}}) }}
            {{ form_widget(form.lastName, {'attr': {'class': 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition'}}) }}
            {{ form_errors(form.lastName) }}
        </div>

        <div class="form-group flex flex-col gap-1">
            {{ form_label(form.fullName, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-700'}}) }}
            {{ form_widget(form.fullName, {'attr': {'class': 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition'}}) }}
            {{ form_errors(form.fullName) }}
        </div>

        <div class="form-group flex flex-col gap-1">
            {{ form_label(form.email, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-700'}}) }}
            {{ form_widget(form.email, {'attr': {'class': 'w-full rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-purple-500 focus:ring-1 focus:ring-purple-500 transition'}}) }}
            {{ form_errors(form.email) }}
        </div>
        
        <div class="form-group flex flex-col gap-1 md:col-span-2">
            {{ form_label(form.roles, null, {'label_attr': {'class': 'text-sm font-semibold text-slate-700'}}) }}
            <div class="flex gap-4 mt-1">
                {% for child in form.roles %}
                    <label class="inline-flex items-center gap-2 cursor-pointer">
                        {{ form_widget(child, {'attr': {'class': 'rounded text-purple-600 focus:ring-purple-500'}}) }}
                        <span class="text-sm text-slate-700">{{ child.vars.label }}</span>
                    </label>
                {% endfor %}
            </div>
            {{ form_errors(form.roles) }}
        </div>
    </div>

    <!-- Toggle Permissions / Checkbox Group UI/UX -->
    <fieldset class="mt-8 border border-slate-200 rounded-xl p-5 bg-slate-50/50">
        <legend class="text-sm font-bold text-slate-800 px-2 uppercase tracking-wide">Access & Permissions</legend>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-y-4 gap-x-6 mt-2">
            {% set checkboxFields = ['isActive', 'isAccessAllCompany', 'isAccessAllBranch', 'isAccessAllBU', 'isAccessAllDivision', 'isAccessAllDept', 'isAccessAllDeptUnit', 'isAccessAllEmpType', 'isDeleted'] %}
            
            {% for fieldName in checkboxFields %}
                <div class="flex items-center justify-between p-3 bg-white rounded-lg border border-slate-200 shadow-sm">
                    {{ form_label(form[fieldName], null, {'label_attr': {'class': 'text-sm font-medium text-slate-700 cursor-pointer flex-1'}}) }}
                    
                    <!-- CSS Toggle Switch Style wrapper -->
                    <label class="relative inline-flex items-center cursor-pointer shrink-0 ml-3">
                        {{ form_widget(form[fieldName], {'attr': {'class': 'sr-only peer'}}) }}
                        <div class="w-9 h-5 bg-slate-200 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-purple-300 rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-purple-600"></div>
                    </label>
                </div>
            {% endfor %}
        </div>
    </fieldset>

    <div class="pt-6 flex items-center gap-4 border-t border-slate-200 mt-6">
        <button type="submit" class="px-5 py-2.5 bg-slate-900 text-white rounded-lg text-sm font-semibold hover:bg-slate-800 shadow-sm transition">{{ button_label|default('Save') }}</button>
        <a href="{{ path('app_user_index') }}" class="px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-semibold hover:bg-slate-50 transition">Cancel</a>
    </div>
{{ form_end(form) }}
