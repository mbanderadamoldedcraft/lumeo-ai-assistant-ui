{% extends 'dashboard_layout.html.twig' %}

{% block title %}User Directory{% endblock %}

{% block content %}
<div class="flex-1 flex flex-col px-8 py-10 w-full max-w-[1024px] mx-auto">
    <div class="page-header py-6 flex justify-between items-center border-b border-slate-200 mb-6">
        <h1 class="text-2xl font-bold text-slate-800">User Directory</h1>
        <a href="{{ path('app_user_new') }}" class="px-4 py-2 bg-slate-900 text-white rounded-md text-sm font-semibold hover:bg-slate-800 transition active:scale-95 shadow-sm">Add New User</a>
    </div>

    {% for message in app.flashes('success') %}
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-xl relative mb-6 shadow-sm" role="alert">
            <span class="block sm:inline font-medium text-sm">{{ message }}</span>
        </div>
    {% endfor %}

    <div class="bg-white rounded-[24px] border border-slate-200/60 shadow-[0_8px_30px_rgb(241,245,249,0.6)] overflow-hidden p-6 transition duration-300 hover:shadow-[0_8px_30px_rgb(241,245,249,0.8)]">
        <table id="usersTable" class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-slate-100 text-xs font-bold tracking-wider text-slate-400 uppercase">
                    <th class="py-4 px-4">Username</th>
                    <th class="py-4 px-4">Full Name</th>
                    <th class="py-4 px-4">Email</th>
                    <th class="py-4 px-4">Status</th>
                    <th class="py-4 px-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="text-[14px] text-slate-700 font-medium">
                {% for user in users %}
                    <tr class="border-b border-slate-50 hover:bg-slate-50/50 transition duration-150">
                        <td class="py-4 px-4 font-semibold text-slate-900">{{ user.username }}</td>
                        <td class="py-4 px-4 text-slate-600">{{ user.fullName|default('-') }}</td>
                        <td class="py-4 px-4 text-slate-600">{{ user.email|default('-') }}</td>
                        <td class="py-4 px-4">
                            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-[11px] font-bold uppercase tracking-wide {{ user.isActive ? 'bg-emerald-50 text-emerald-600 border border-emerald-100' : 'bg-slate-50 text-slate-500 border border-slate-200' }}">
                                {{ user.isActive ? 'Active' : 'Inactive' }}
                            </span>
                        </td>
                        <td class="py-4 px-4 text-right">
                            <a href="{{ path('app_user_show', {'id': user.id}) }}" class="text-purple-600 hover:text-purple-800 font-bold transition mx-2">View</a>
                            <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="text-slate-500 hover:text-slate-800 font-bold transition mx-2">Edit</a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="py-8 px-4 text-center text-slate-400 font-medium">No users found.</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- Load jQuery and DataTables -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function() {
            if ($.fn.DataTable.isDataTable('#usersTable')) {
                $('#usersTable').DataTable().destroy();
            }
            
            $('#usersTable').DataTable({
                destroy: true,
                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],
                language: {
                    search: "",
                    searchPlaceholder: "Search Users..."
                },
                dom: '<"flex flex-col md:flex-row justify-between items-center mb-6 gap-4"lf>rt<"flex flex-col md:flex-row justify-between items-center mt-6 gap-4"ip>',
            });
            // Style DataTables inputs
            $('.dataTables_filter input').addClass('border border-slate-200 rounded-lg px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 ml-2 shadow-sm');
            $('.dataTables_length select').addClass('border border-slate-200 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500/20 focus:border-purple-500 mx-2 bg-white shadow-sm');
        });
    </script>
    <style>
        /* Minimal custom styles for DataTables to override defaults and match UI */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            padding: 0.25rem 0.75rem;
            margin-left: 0.25rem;
            border-radius: 0.5rem;
            border: 1px solid transparent;
            font-size: 0.875rem;
            font-weight: 500;
            color: #475569 !important;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: #f8fafc !important;
            border-color: #e2e8f0 !important;
            color: #0f172a !important;
        }
        .dataTables_wrapper .dataTables_paginate .paginate_button.current, 
        .dataTables_wrapper .dataTables_paginate .paginate_button.current:hover {
            background: #f1f5f9 !important;
            border-color: #cbd5e1 !important;
            color: #0f172a !important;
            font-weight: 600;
        }
        table.dataTable.no-footer {
            border-bottom: none !important;
        }
    </style>
{% endblock %}
