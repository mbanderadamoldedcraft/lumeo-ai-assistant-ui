{% extends 'dashboard_layout.html.twig' %}

{% block title %}Create New User{% endblock %}

{% block content %}
<div class="flex-1 flex flex-col px-8 py-10 w-full max-w-[1024px] mx-auto">
    <div class="page-header py-6 border-b border-slate-200 mb-6 flex justify-between items-center">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Create New User</h1>
            <p class="text-slate-500 text-sm mt-1">Fill in the details below to add a new user to the system.</p>
        </div>
        <a href="{{ path('app_user_index') }}" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-semibold hover:bg-slate-50 transition active:scale-95 shadow-sm">Back to List</a>
    </div>

    <div class="bg-white rounded-[24px] border border-slate-200/60 shadow-[0_8px_30px_rgb(241,245,249,0.6)] p-8">
        {{ include('user/_form.html.twig', {'button_label': 'Create User'}) }}
    </div>
</div>
{% endblock %}
