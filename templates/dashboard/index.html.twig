{% extends 'dashboard_layout.html.twig' %}

{% block title %}Good Afternoon, Jason - Lumeo Dashboard{% endblock %}

{% block content %}
<!-- CENTER MAIN WORKSPACE -->
<div class="flex-1 flex flex-col justify-center items-center px-6 py-12 max-w-[820px] mx-auto w-full">
    
    <!-- Sphere Icon -->
    <div class="sphere-container">
        <div class="sphere-glass"></div>
        <div class="sphere-shadow"></div>
    </div>
    
    <!-- Greeting & Hero Text -->
    <h1 class="text-[38px] font-semibold text-slate-800 tracking-tight text-center leading-[1.18] mt-8">
        Good Afternoon, Jason <br>
        What's on <span class="text-[#ab51e5] inline-block font-semibold">your mind?</span>
    </h1>
    
    <!-- Main Question/Input Area -->
    <div class="w-full bg-white border border-slate-200/50 rounded-[28px] shadow-[0_8px_30px_rgb(241,245,249,0.5)] p-5 mt-10 flex flex-col gap-4 focus-within:border-slate-300 transition duration-300">
        
        <!-- Textarea Row -->
        <div class="flex gap-3 items-start">
            <div class="pt-1.5 text-slate-400 shrink-0">
                <svg class="w-[18px] h-[18px] text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/>
                </svg>
            </div>
            <div class="flex-1">
                <textarea id="ai-input" rows="2" class="w-full border-0 p-0 text-[15px] font-normal text-slate-800 placeholder-slate-400 focus:ring-0 focus:outline-none bg-transparent resize-none leading-relaxed" placeholder="Ask AI a question or make a request..."></textarea>
            </div>
        </div>
        
        <!-- Bottom controls -->
        <div class="flex items-center justify-between border-t border-slate-100 pt-4 mt-1">
            <div class="flex items-center gap-2">
                <!-- Attach Button -->
                <button class="flex items-center gap-1.5 px-4 py-2 bg-slate-50 hover:bg-slate-100 text-[12px] font-bold text-slate-600 rounded-full border border-slate-200/40 transition active:scale-95 cursor-pointer">
                    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </svg>
                    Attach
                </button>
                
                <!-- Writing Styles Button -->
                <button id="writing-style-btn" class="flex items-center gap-1.5 px-4 py-2 bg-slate-50 hover:bg-slate-100 text-[12px] font-bold text-slate-600 rounded-full border border-slate-200/40 transition active:scale-95 cursor-pointer">
                    Writing Styles
                </button>
            </div>
            
            <div class="flex items-center gap-3">
                <!-- Citation Toggle -->
                <div class="flex items-center gap-2 cursor-pointer" id="citation-toggle-wrapper">
                    <span class="text-[12px] font-bold text-slate-500 select-none">Citation</span>
                    <div id="citation-toggle" class="w-9 h-5 bg-purple-600 rounded-full p-0.5 transition duration-200 relative">
                        <div id="citation-toggle-dot" class="w-4 h-4 bg-white rounded-full shadow-sm transition duration-200 transform translate-x-4"></div>
                    </div>
                </div>
                
                <!-- Send Button -->
                <button id="send-btn" class="w-9 h-9 rounded-xl bg-slate-900 text-white flex items-center justify-center hover:bg-slate-800 transition active:scale-95 shadow-sm cursor-pointer" title="Send Request">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="12" y1="19" x2="12" y2="5"/>
                        <polyline points="5 12 12 5 19 12"/>
                    </svg>
                </button>
            </div>
        </div>
    </div>
    
    <!-- Suggestions / Examples Section -->
    <div class="w-full mt-12 flex flex-col gap-4">
        <span class="text-[11px] font-bold tracking-widest text-slate-400/90 uppercase text-left">GET STARTED WITH AN EXAMPLE BELOW</span>
        
        <div class="grid grid-cols-4 gap-4 w-full">
            <!-- Card 1 -->
            <div class="suggestion-card bg-[#f4f6fa]/60 border border-slate-200/25 p-4 rounded-2xl h-[135px] flex flex-col justify-between shadow-sm/5" data-prompt="Write a to-do list for a personal project">
                <p class="text-[13px] font-medium text-slate-600 leading-[1.4] pr-2">Write a to-do list for a personal project</p>
                <div class="text-slate-400">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                    </svg>
                </div>
            </div>
            
            <!-- Card 2 -->
            <div class="suggestion-card bg-[#f4f6fa]/60 border border-slate-200/25 p-4 rounded-2xl h-[135px] flex flex-col justify-between shadow-sm/5" data-prompt="Generate an email to reply to a job offer">
                <p class="text-[13px] font-medium text-slate-600 leading-[1.4] pr-2">Generate an email to reply to a job offer</p>
                <div class="text-slate-400">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="2" y="4" width="20" height="16" rx="2"/>
                        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
                    </svg>
                </div>
            </div>
            
            <!-- Card 3 -->
            <div class="suggestion-card bg-[#f4f6fa]/60 border border-slate-200/25 p-4 rounded-2xl h-[135px] flex flex-col justify-between shadow-sm/5" data-prompt="Summarize this article in one paragraph">
                <p class="text-[13px] font-medium text-slate-600 leading-[1.4] pr-2">Summarize this article in one paragraph</p>
                <div class="text-slate-400">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </div>
            </div>
            
            <!-- Card 4 -->
            <div class="suggestion-card bg-[#f4f6fa]/60 border border-slate-200/25 p-4 rounded-2xl h-[135px] flex flex-col justify-between shadow-sm/5" data-prompt="How does AI work in a technical capacity">
                <p class="text-[13px] font-medium text-slate-600 leading-[1.4] pr-2">How does AI work in a technical capacity</p>
                <div class="text-slate-400">
                    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6"/>
                        <polyline points="8 6 2 12 8 18"/>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
    // 4. Citation Toggle
    const citationWrapper = document.getElementById('citation-toggle-wrapper');
    const citationToggle = document.getElementById('citation-toggle');
    const citationDot = document.getElementById('citation-toggle-dot');
    let citationActive = true;

    if (citationWrapper) {
        citationWrapper.addEventListener('click', () => {
            citationActive = !citationActive;
            if (citationActive) {
                citationToggle.classList.remove('bg-slate-300');
                citationToggle.classList.add('bg-purple-600');
                citationDot.classList.remove('translate-x-0');
                citationDot.classList.add('translate-x-4');
            } else {
                citationToggle.classList.remove('bg-purple-600');
                citationToggle.classList.add('bg-slate-300');
                citationDot.classList.remove('translate-x-4');
                citationDot.classList.add('translate-x-0');
            }
        });
    }

    const aiInput = document.getElementById('ai-input');

    if (aiInput) {
        // 6. Dynamic Auto-Resizing Textarea
        aiInput.addEventListener('input', () => {
            aiInput.style.height = 'auto';
            aiInput.style.height = aiInput.scrollHeight + 'px';
        });
    }

    // 7. New Thread Button action
    const newThreadBtn = document.getElementById('new-thread-btn');
    if (newThreadBtn && aiInput) {
        newThreadBtn.addEventListener('click', () => {
            aiInput.value = '';
            aiInput.style.height = 'auto';
            aiInput.focus();
        });
    }

    // 10. Send Action
    const sendBtn = document.getElementById('send-btn');
    if (sendBtn && aiInput) {
        sendBtn.addEventListener('click', () => {
            if (aiInput.value.trim() === '') {
                aiInput.focus();
                return;
            }
            aiInput.value = '';
            aiInput.style.height = 'auto';
        });
    }
</script>
{% endblock %}
